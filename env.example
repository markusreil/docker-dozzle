# dozzle - real-time container log viewer, one instance per docker host,
# behind nginx-proxy. Copy to .env and edit: cp env.example .env
#
# Required - compose fails fast when these are missing:
# --- Global ---
# Docker network name shared between the proxy and proxied containers
# (must already exist on the host, created by the nginx-proxy project).
NGINX_PROXY_NETWORK=web-proxy
# Root domain this host serves (vhost becomes dozzle.<BASE_DOMAIN>).
BASE_DOMAIN=localhost
# Timezone for the container.
TZ=UTC

# --- dozzle ---
# Pinned upstream image tag (amir20/dozzle, scratch base). Bump deliberately;
# never `latest` (see dozzle/README.md for the alpine variant).
DOZZLE_VERSION=v10.9.2
# Name shown in the dozzle header and multi-host menu.
DOZZLE_HOSTNAME=dozzle
# Log verbosity: debug | info | warn | error.
DOZZLE_LEVEL=info
# Login provider: none (open, LAN-only) or simple (login via /data/users.yml).
# Enabling `simple` requires mounting a users file - see dozzle/README.md.
DOZZLE_AUTH_PROVIDER=none